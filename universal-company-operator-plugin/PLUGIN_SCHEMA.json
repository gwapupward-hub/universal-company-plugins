{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyOSPlugin",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "capabilities",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "analyze",
          "publish",
          "deploy",
          "notify",
          "collect_payment",
          "onchain_lookup",
          "create_task"
        ]
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "api_key",
            "oauth",
            "webhook_secret",
            "bearer",
            "none"
          ]
        },
        "envVars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "method",
          "endpoint",
          "requiredInputs",
          "output",
          "usedByCommands",
          "requiresApproval"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "requiredInputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "string"
          },
          "usedByCommands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiresApproval": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

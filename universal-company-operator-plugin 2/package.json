{
  "name": "universal-company-operator-plugin",
  "version": "1.0.0",
  "description": "OpenClaw plugin for Universal Company Operator System execution commands.",
  "main": "src/index.js",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "plugin",
    "operations",
    "company",
    "startup",
    "agent"
  ],
  "openclaw": {
    "type": "plugin",
    "manifest": "OpenClaw.plugin.json",
    "extensions": [
      {
        "type": "plugin",
        "path": "OpenClaw.plugin.json"
      }
    ],
    "compat": {
      "pluginApi": "^1.0.0"
    },
    "build": {
      "openclawVersion": "1.0.0"
    }
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/index.js --self-test"
  },
  "engines": {
    "node": ">=18"
  }
}
